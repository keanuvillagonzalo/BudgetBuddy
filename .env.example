# .env.example

# Clerk Authentication
# VITE_CLERK_PUBLISHABLE_KEY is required for the frontend build and exposed to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY is required for backend server-side token verification
CLERK_SECRET_KEY=sk_test_...

# Plaid Configuration
# PLAID_CLIENT_ID and PLAID_SECRET are required for the backend runtime
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=production  #options: sandbox, production